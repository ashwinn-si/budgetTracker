# --- MongoDB ---
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/budget-tracker?retryWrites=true&w=majority

# --- Auth.js / NextAuth ---
NEXTAUTH_URL=http://localhost:5173
NEXTAUTH_SECRET=your_nextauth_secret_here_generate_with_openssl_rand_base64_32

# --- Google OAuth (login + Sheets access) ---
# Scopes needed: openid, email, profile, https://www.googleapis.com/auth/spreadsheets
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Custom access/refresh tokens (email+password auth) ---
JWT_ACCESS_SECRET=your_jwt_access_secret_32_chars_minimum
JWT_REFRESH_SECRET=your_jwt_refresh_secret_32_chars_minimum
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=30d

# --- Transactional email (password reset) ---
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="BudgetFlow <no-reply@yourdomain.com>"

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:5173
